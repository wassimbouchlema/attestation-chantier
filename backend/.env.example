# --- Django ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production : origines complètes (schéma inclus), séparées par des virgules
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO
# Production : mettre une valeur (ex. 31536000) une fois HTTPS validé
SECURE_HSTS_SECONDS=0

# --- Base de données ---
# Soit DATABASE_URL (prioritaire), soit les variables POSTGRES_*
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
POSTGRES_DB=attestation_db
POSTGRES_USER=attestation_user
POSTGRES_PASSWORD=attestation_pwd
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Azure Database for PostgreSQL : require
POSTGRES_SSLMODE=
DB_CONN_MAX_AGE=60

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Stockage des fichiers (vide = système de fichiers local backend/media) ---
# Azure Blob Storage (conteneur privé) : connection string, ou nom de compte + clé
# (secrets Container Apps ; Managed Identity + RBAC = amélioration future)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=media

# --- Email (défaut : backend console) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@attestation-chantier.local

# --- IA ---
AI_COHERENCE_BACKEND=simulation
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# --- Extraction de document (préremplissage FDR) ---
# fake (défaut, aucun réseau) ou mistral
DOCUMENT_EXTRACTION_BACKEND=fake
MISTRAL_DOCUMENT_MODEL=mistral-ocr-latest
